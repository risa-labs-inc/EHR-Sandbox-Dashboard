{
  "hosting": {
    "site": "ehr-sandbox",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/static/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "/downloads/**",
        "headers": [
          { "key": "Content-Disposition", "value": "attachment" }
        ]
      }
    ]
  }
}
